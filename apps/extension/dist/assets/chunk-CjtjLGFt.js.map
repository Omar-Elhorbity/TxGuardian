export default "{\"manifest_version\":3,\"name\":\"TxGuardian\",\"version\":\"0.1.0\",\"description\":\"Pre-sign safety verdict for Solana transactions. Inspects what your wallet is about to sign.\",\"permissions\":[\"storage\"],\"host_permissions\":[\"http://localhost:3000/*\",\"https://*.vercel.app/*\",\"https://api.devnet.solana.com/*\",\"https://api.mainnet-beta.solana.com/*\"],\"background\":{\"service_worker\":\"src/background.ts\",\"type\":\"module\"},\"content_scripts\":[{\"matches\":[\"<all_urls>\"],\"js\":[\"src/content.ts\"],\"run_at\":\"document_start\",\"all_frames\":true}],\"web_accessible_resources\":[{\"resources\":[\"page.js\"],\"matches\":[\"<all_urls>\"]}],\"action\":{\"default_title\":\"TxGuardian\"}}"