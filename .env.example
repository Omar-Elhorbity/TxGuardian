# Solana RPC endpoint (server-side). Public RPCs rate-limit aggressively —
# use Helius or QuickNode for any real traffic.
# Free dev keys: https://helius.dev or https://quicknode.com
RPC_URL=https://api.devnet.solana.com

# Google AI Studio API key for the AI Explainer (full mode only). Server-side only.
# Free key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: override the default LLM model (defaults to gemini-2.5-flash)
# TXGUARDIAN_MODEL=gemini-2.5-flash

# Optional: explicit canonical site URL for metadata + OG tags. If unset:
#   - On Vercel: VERCEL_PROJECT_PRODUCTION_URL is used automatically
#   - Locally: defaults to http://localhost:3000
# Set this if you have a custom domain (e.g. https://txguardian.com).
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: server-side error tracking (Sentry). UNSET BY DEFAULT — with no
# DSN, nothing is initialized and no data leaves the server. When set, only
# server/API errors are captured (no browser SDK, no CSP change), and request
# bodies + transaction-shaped strings are scrubbed before send. See
# docs/observability.md and docs/agdr/AgDR-0002-web-observability.md.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
