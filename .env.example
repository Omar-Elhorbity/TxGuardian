# Solana RPC endpoint. Public RPCs rate-limit aggressively — use Helius or QuickNode for the demo.
# Free dev keys: https://helius.dev or https://quicknode.com
RPC_URL=https://api.devnet.solana.com

# Google AI Studio API key for the AI Explainer (full mode only). Server-side only.
# Get one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: override the default model (defaults to gemini-2.5-flash)
# TXGUARDIAN_MODEL=gemini-2.5-flash
