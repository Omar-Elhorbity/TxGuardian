# Solana RPC endpoint. Public RPCs rate-limit aggressively — use Helius or QuickNode for the demo.
# Free dev keys: https://helius.dev or https://quicknode.com
RPC_URL=https://api.devnet.solana.com

# Anthropic API key for the AI Explainer (full mode only). Server-side only.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the default model (defaults to claude-haiku-4-5)
# TXGUARDIAN_MODEL=claude-haiku-4-5
